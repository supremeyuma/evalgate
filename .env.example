# Local development defaults. Copy to `.env` and adjust as needed.
# These host ports are reserved for EvalGate so parallel local stacks do not collide.
DATABASE_URL=postgresql+asyncpg://evalgate:evalgate@localhost:5434/evalgate
REDIS_URL=redis://localhost:6381/0

# Provider credentials are optional. Every test, demo, and CI job runs with --mock.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# API (demo only; the CLI is the primary interface).
EVALGATE_API_KEY=dev-key
EVALGATE_API_PORT=8001

# Judge defaults.
JUDGE_MODEL=gpt-4.1-mini
JUDGE_CACHE_DIR=.evalgate-cache
JUDGE_CACHE_BACKEND=local
