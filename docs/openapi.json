      },
      "RunRequest": {
        "additionalProperties": false,
        "description": "Start a run from a suite path or inline YAML.",
        "properties": {
          "baseline_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
