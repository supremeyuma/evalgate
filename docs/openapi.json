            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Concurrency",
            "type": "integer"
          },
          "git_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Git Ref"
          },
